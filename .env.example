# Configurações de acesso ao Arena AI (https://arena.ai)
# Copie para .env (na raiz do repo/skill, ao lado de SKILL.md). O .env é ignorado pelo Git.
ARENA_EMAIL=your_email@example.com
ARENA_PASSWORD=your_password

# Opcionais
ARENA_HEADLESS=true
# Perfil do navegador (cookies). Padrão: %LOCALAPPDATA%\gabebrain\arena-ai-controller
# NUNCA aponte para Google Drive / vault Obsidian: cookies de login iriam para a nuvem.
# ARENA_USER_DATA_DIR=
# 1 = apaga o perfil ao fim de cada execução (mais seguro, exige login a cada uso)
# ARENA_PURGE_AFTER_USE=0
# Substitui o prefixo que instrui o Arena a usar as skills do gabebrain-skills
# ARENA_SKILL_PREFIX=
